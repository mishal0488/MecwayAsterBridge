listinst = DEFI_LIST_INST(
    DEFI_LIST=_F(LIST_INST=times),
    ECHEC=_F(EVENEMENT='ERREUR', ACTION='DECOUPE',
             SUBD_METHODE='MANUEL', SUBD_PAS=4,
             SUBD_NIVEAU=6),
)



# =====================================================
# 7. RANDVOORWAARDEN EN BELASTINGEN  (AFFE_CHAR_MECA / _F)
# load_1: randvoorwaarden (DDL_IMPO, LIAISON_*) en couplings; daarna een
# last per belasting (FORCE_*, PRES_REP, PESANTEUR), omdat Code-Aster
# belastingen binnen een last overschrijft i.p.v. optelt. Componenten met
# een tijdshistorie verwijzen naar de DEFI_FONCTION's uit stap 6a
# (AFFE_CHAR_MECA_F, of FONC_MULT in EXCIT voor een moment op vlakken).
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=_F(GROUP_NO='Inklemming', BLOCAGE=('DEPLACEMENT', 'ROTATION')),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_NODALE=_F(GROUP_NO='Tip', FZ=-10.0),
)


# =====================================================
# 8. SOLVER: NIET-LINEAIRE DYNAMICA  (DYNA_NON_LINE)
# Impliciet (HHT/NEWMARK): Newton-Raphson per tijdstap; expliciet
# (DIFF_CENT/TCHAMWA): diagonale massa, geen iteraties, STOP_CFL.
# Contact (DEFI_CONTACT, CONTINUE) en de beginsnelheid (ETAT_INIT VITE)
# staan in dit blok als het model ze heeft.
#
#   CARA_ELEM     - alleen als stap 3b een AFFE_CARA_ELEM bevat.
#   EXCIT         - alle lasten uit stap 7 (load_1, load_2, ...).
#   COMPORTEMENT  - per elset (en POI1-groep): RELATION ('ELAS',
#                   'VMIS_ISOT_TRAC', 'VMIS_ISOT_LINE', 'VMIS_CINE_LINE',
#                   'CABLE' of voor gaps 'DIS_CHOC') en DEFORMATION uit
#                   CONFIG_BRIDGE ("deformation", standaard 'GROT_GDEP';
#                   per elset de vorm die Code-Aster accepteert,
#                   bridge_to_aster._deformation_for). Zonder elsets:
#                   TOUT='OUI', 'ELAS'.
#   INCREMENT     - LIST_INST koppelt aan listinst (stap 6b).
#   SOLVEUR       - MUMPS met NPREC uit CONFIG_BRIDGE ("solver_nprec").
#   NEWTON        - REAC_ITER uit CONFIG_BRIDGE ("newton_reac_iter",
#                   standaard 1 = tangente matrix elke iteratie).
#   CONVERGENCE   - RESI_GLOB_RELA en ITER_GLOB_MAXI uit CONFIG_BRIDGE
#                   ("convergence_resi_rela", "newton_max_iter").
# =====================================================
try:
    res = DYNA_NON_LINE(
        MODELE=model,
        CHAM_MATER=fieldmat,
        CARA_ELEM=cara,
        EXCIT=(
            _F(CHARGE=load_1),
            _F(CHARGE=load_2),
        ),
        COMPORTEMENT=_F(GROUP_MA='Balk', RELATION='ELAS', DEFORMATION='PETIT'),
        INCREMENT=_F(LIST_INST=listinst),
        SCHEMA_TEMPS=_F(SCHEMA='HHT', ALPHA=-0.1, FORMULATION='DEPLACEMENT'),
        ARCHIVAGE=_F(LIST_INST=outlist),
        SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
        NEWTON=_F(REAC_ITER=1),
        CONVERGENCE=_F(RESI_GLOB_RELA=1e-05, ITER_GLOB_MAXI=20),
    )
except Exception as err:
    if not str(getattr(err, 'id_message', '')).startswith('MECANONLINE'):
        raise
    print('BRIDGE_ONVOLLEDIG', res.getAccessParameters()['INST'][-1])
t_res = res.getAccessParameters()['INST'][-1]


# =====================================================
# 9. POST-PROCESSING VELDEN BEREKENEN  (CALC_CHAMP)
# Zelfde velden als MECA_STATIQUE; heeft minstens een materiaal een
# hardingscurve, dan komen er op de 3D-elsets bij:
#   EPSP_NOEU  - plastische strain tensor
#   VARI_NOEU  - interne variabelen (V1 = eq. plastische strain)
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)

# Balken: extreme axiale spanning in de doorsnede.
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Balk',),
    CONTRAINTE=('SIPM_ELNO', ),
)



