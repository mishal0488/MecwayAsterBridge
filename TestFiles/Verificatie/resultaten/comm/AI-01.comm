# Code_Aster Command File - Gegenereerd via MecwayAsterBridge
# Template voor akoestische holtemodes (Mecway A30, Acoustic Resonance
# 3D): PHENOMENE='ACOUSTIQUE', ASSEMBLAGE RIGI_ACOU/MASS_ACOU en
# CALC_MODES. Invulling via str.format() vanuit bridge_acoustic.py
# (build_acoustic_modes).
#
# Placeholders (naam tussen enkele accolades):
#   model_block       -> AFFE_MODELE (volumes, ACOUSTIQUE / 3D)
#   materials_block   -> DEFI_MATERIAU FLUIDE per materiaal
#   fieldmat_block    -> AFFE_MATERIAU toewijzing
#   loads_block       -> AFFE_CHAR_ACOU PRES_IMPO (drukknopen) en #ASTER-code
#   assemblage_block  -> ASSEMBLAGE en de reele matrices (COMB_MATR_ASSE)
#   calc_modes_block  -> res = CALC_MODES(...)
#   export_block      -> aster_results_export (een <mode> per holtemode)
#   impr_resu_block   -> IMPR_RESU MED (alleen met "med_export")
#
# Een accolade die geen placeholder is: verdubbelen ({ of }).

# Taal van de meldingen van de jobscripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. MODEL EN MATERIALEN (lucht/vloeistof)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=('Lucht',), PHENOMENE='ACOUSTIQUE', MODELISATION='3D'),
        _F(GROUP_MA=('Absorbeerder',), PHENOMENE='ACOUSTIQUE', MODELISATION='3D_ABSO'),
    ),
)


# materiaal 'Lucht'
MAC1 = DEFI_MATERIAU(FLUIDE=_F(RHO=1.2, CELE_R=340.0))
# Impedantievlakken: CELE_R = 1 geeft AMOR_ACOU = int N N dA (bridge_acoustic,
# complexe modes); de andere impedantievlakken in dezelfde matrix ~0.
MAZ1 = DEFI_MATERIAU(FLUIDE=_F(RHO=1.0, CELE_R=1.0))
MAZ0 = DEFI_MATERIAU(FLUIDE=_F(RHO=1.0, CELE_R=1.0e+30))


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Lucht', MATER=MAC1),
        _F(GROUP_MA='Absorbeerder', MATER=MAC1),
    ),
)


# =====================================================
# 3. DRUKKNOPEN (p = 0); vlakken zonder voorwaarde zijn harde wanden
# =====================================================
#-- drukknopen: in aster_acoustic_complex geelimineerd (geen) --


# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigi_c'), OPTION='RIGI_ACOU'),
        _F(MATRICE=CO('mass_c'), OPTION='MASS_ACOU'),
    ),
)
# Impedantie Absorbeerder: Z = 2000
chz1 = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Lucht', MATER=MAC1),
        _F(GROUP_MA='Absorbeerder', MATER=MAZ1),
    ),
)
mez1 = CALC_MATR_ELEM(OPTION='AMOR_ACOU', MODELE=model, CHAM_MATER=chz1)
amz1 = ASSE_MATRICE(MATR_ELEM=mez1, NUME_DDL=numedd)


# =====================================================
# 5. HOLTEMODES (CALC_MODES, U4.52.02)
# =====================================================
# Complexe modes (impedantie): kwadratisch eigenwaardeprobleem
# (K + l C + l^2 M) P = 0, C = sum rho/Z int N N dA (Mecway manual
# par. 6.9.2), opgelost met scipy in aster_acoustic_complex
# (CALC_MODES neemt MATR_AMOR niet voor drukmatrices).
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_acoustic_complex
aster_acoustic_complex.solve_modes(
    rigi_c, mass_c, [
        (amz1, complex(0.0006, 0.0), 'Absorbeerder: Z = 2000'),
    ],
    numedd, mesh, '<WORKDIR>\\AI-01\\AI-01_verif_results.xml', '<WORKDIR>\\AI-01\\AI-01.liml',
    n_modes=6, dirichlet=[],
    shift_hz=0.0, free_shift_hz=-16.8325082306035, c_ref=340.0, size_ref=1.00995049383621,
    tolerance=1e-06, precision='double')


# =====================================================
# 6. RESULTATEN NAAR MECWAY
# =====================================================
#-- geen #ASTER-POST --


#-- geen MED-export (complexe modes: geen Code-Aster-resultaat) --


FIN()
