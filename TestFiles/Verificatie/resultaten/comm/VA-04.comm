# Code_Aster Command File - Gegenereerd via MecwayAsterBridge
# Template voor vibro-akoestiek: gekoppelde eigenmodes van een constructie
# en een lucht- of vloeistofvolume (Mecway Frequency-model V30 met een
# fluidum-onderdeel). PHENOMENE='MECANIQUE' met 3D_FLUIDE (fluidum),
# FLUI_STRU (koppelvlak) en de gewone mechanische elementen, FORMULATION
# 'U_P_PHI' (testcase adlv100a). Invulling via str.format() vanuit
# bridge_vibroacoustic.build_vibroacoustic_modes.
#
# Placeholders (naam tussen enkele accolades):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE
#                        (constructie, zoals modaal) en ORIE_PEAU van de
#                        koppelvlakken (normaal uit het fluidum)
#   model_block       -> AFFE_MODELE: constructie, 3D_FLUIDE, FLUI_STRU
#   cara_elem_block   -> AFFE_CARA_ELEM (balken, schalen, veren, massa's)
#   materials_block   -> DEFI_MATERIAU: ELAS (constructie), FLUIDE (RHO,
#                        CELE_R)
#   fieldmat_block    -> AFFE_MATERIAU (koppelvlakken krijgen het fluidum)
#   loads_block       -> opleggingen van de constructie en drukknopen
#                        (DDL_IMPO PRES = 0, PHI = 0)
#   assemblage_block  -> ASSEMBLAGE RIGI_MECA en MASS_MECA
#   calc_modes_block  -> band zoeken (INFO_MODE), CALC_MODES BANDE,
#                        EXTR_MODE -> res
#   export_block      -> aster_results_export (een <mode> per mode met
#                        displ en pressure)
#   impr_resu_block   -> IMPR_RESU MED (alleen met "med_export")
#
# Een accolade die geen placeholder is: verdubbelen ({ of }).

# Taal van de meldingen van de jobscripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --


# =====================================================
# 2. MODEL, SECTIES, MATERIALEN
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Lucht', PHENOMENE='MECANIQUE', MODELISATION='3D_FLUIDE', FORMULATION='U_P_PHI'),
        _F(GROUP_MA='Gas', PHENOMENE='MECANIQUE', MODELISATION='3D_FLUIDE', FORMULATION='U_P_PHI'),
    ),
)


#-- geen constructie --


# materiaal 'Lucht'
MAF1 = DEFI_MATERIAU(FLUIDE=_F(RHO=1.2, CELE_R=340.0))
# materiaal 'Gas'
MAF2 = DEFI_MATERIAU(FLUIDE=_F(RHO=1.2, CELE_R=680.0))


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Lucht', MATER=MAF1),
        _F(GROUP_MA='Gas', MATER=MAF2),
    ),
)


# =====================================================
# 3. RANDVOORWAARDEN (opleggingen, drukknopen)
# =====================================================


# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


# =====================================================
# 5. GEKOPPELDE EIGENMODES (INFO_MODE, CALC_MODES BANDE)
# =====================================================
# Gekoppelde modes (U_P_PHI): elke vrijheidsgraad PHI geeft een
# valse mode bij 0 Hz; daarom de band [f_min, f_max] met minstens
# bridge_n modes (Sturm-telling INFO_MODE) en CALC_MODES BANDE
# (bridge_vibroacoustic._mode_search_block).
bridge_n = 3
bridge_fmin = 0.1

def _bridge_count(_fhi):
    _t = INFO_MODE(TYPE_MODE='DYNAMIQUE', MATR_RIGI=rigidite,
                   MATR_MASS=masse, FREQ=(bridge_fmin, _fhi),
                   SOLVEUR=_F(METHODE='MUMPS', NPREC=8))
    return int(_t.EXTR_TABLE().values()['NB_MODE'][0])

_lo, _hi = bridge_fmin, max(10.0 * bridge_fmin, 1.0)
_nhi = _bridge_count(_hi)
while _nhi < bridge_n and _hi < 1.0e7:
    _lo, _hi = _hi, 4.0 * _hi
    _nhi = _bridge_count(_hi)
for _k in range(2):
    _mid = (_lo * _hi) ** 0.5
    if _mid <= _lo * 1.0001:
        break
    _nmid = _bridge_count(_mid)
    if _nmid >= bridge_n:
        _hi, _nhi = _mid, _nmid
    else:
        _lo = _mid
print('BRIDGE_VIBRO_BAND', bridge_fmin, _hi, _nhi)
if _nhi < 1:
    raise ValueError('BRIDGE_VIBRO: geen modes tussen %g en %g Hz' % (bridge_fmin, _hi))
# Zonder NORM_MODE: BANDE kan ook een valse mode buiten de band
# teruggeven (gezien: 3e-5 Hz met MASS_GENE < 0); normeren op
# MASS_GENE gaf dan <EXCEPTION> DVP_2. Eerst filteren, dan normeren.
res_band = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='BANDE',
    CALC_FREQ=_F(FREQ=(bridge_fmin, _hi)),
    SOLVEUR_MODAL=_F(COEF_DIM_ESPACE=4),
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
_tb = RECU_TABLE(CO=res_band, NOM_PARA=('FREQ', 'MASS_GENE')).EXTR_TABLE().values()
_good = [_i for _i, _f, _m in zip(_tb['NUME_ORDRE'], _tb['FREQ'],
                                  _tb['MASS_GENE'])
         if _f >= bridge_fmin * (1.0 - 1.0e-6) and _m > 0.0]
_spur = len(_tb['NUME_ORDRE']) - len(_good)
if _spur:
    print('BRIDGE_VIBRO_VALS', _spur)
if len(_good) < bridge_n:
    print('BRIDGE_VIBRO_TEKORT', len(_good), bridge_n)
if not _good:
    raise ValueError('BRIDGE_VIBRO: geen bruikbare modes tussen %g en %g Hz' % (bridge_fmin, _hi))
res = EXTR_MODE(FILTRE_MODE=_F(MODE=res_band,
                               NUME_ORDRE=tuple(_good[:bridge_n])))
res = NORM_MODE(reuse=res, MODE=res, NORME='MASS_GENE')


# =====================================================
# 6. RESULTATEN NAAR MECWAY
# =====================================================
# Resultaten in Mecway's eigen formaat (result_route 'liml')
_tf = RECU_TABLE(CO=res, NOM_PARA=('FREQ',)).EXTR_TABLE().values()
for _i, _f in zip(_tf['NUME_ORDRE'], _tf['FREQ']):
    print('BRIDGE_MODE {0} FREQ={1!r}'.format(_i, _f))
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\VA-04\\VA-04_verif_results.xml', '<WORKDIR>\\VA-04\\VA-04.liml',
    fields=['displacements', 'pressure'], precision='double')


#-- geen MED-export (instelling med_export uit) --


FIN()
