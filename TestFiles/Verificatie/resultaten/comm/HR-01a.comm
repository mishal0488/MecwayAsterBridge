# Code_Aster Command File - Gegenereerd via MecwayAsterBridge
# Template voor de harmonische respons van een constructie in het
# frequentiedomein (analyse harmonic_3d; Mecway heeft daar geen
# analysetype voor): eigenmodes (CALC_MODES), de frequentielijst met extra
# punten rond de resonanties (DEFI_LIST_FREQ), de harmonische respons op
# modale basis (PROJ_BASE, DYNA_VIBRA TYPE_CALCUL='HARM' BASE_CALCUL='GENE',
# REST_GENE_PHYS) of direct (BASE_CALCUL='PHYS'), complexe spanningen
# (CALC_CHAMP) en per frequentie amplitude en fase naar Mecway. Invulling
# via str.format() vanuit bridge_harmonic.py.
#
# Placeholders (naam tussen enkele accolades):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE
#   model_block       -> AFFE_MODELE per elset
#   cara_elem_block   -> AFFE_CARA_ELEM (balken, schalen, veren, knoopmassa's)
#   materials_block   -> DEFI_MATERIAU per materiaal (met RHO)
#   fieldmat_block    -> AFFE_MATERIAU toewijzing
#   load_funcs_block  -> DEFI_FONCTION per Mecway-tabel (functie van FREQ)
#   loads_block       -> AFFE_CHAR_MECA(_F): opleggingen en belastingen
#   assemblage_block  -> ASSEMBLAGE: RIGI_MECA, MASS_MECA (en AMOR_MECA van
#                        dempers) met de opleggingen
#   calc_modes_block  -> modes = CALC_MODES(...) en het modeoverzicht
#   projection_block  -> belastingsvectoren (CALC_VECT_ELEM, ASSE_VECTEUR),
#                        PROJ_BASE (GENE) of de dempingsmatrix (PHYS)
#   harm_block        -> modale demping, frequentielijst, DYNA_VIBRA HARM
#                        (en REST_GENE_PHYS) -> res
#   calc_champ_block  -> CALC_CHAMP SIGM_NOEU (complex) op res
#   export_block      -> aster_harmonic_export (Mecway-resultaten per
#                        frequentie, meetpunten)
#   impr_resu_block   -> IMPR_RESU MED (alleen met "med_export")
#
# Een accolade die geen placeholder is: verdubbelen ({ of }).

# Taal van de meldingen van de jobscripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --


# =====================================================
# 2. MODEL, SECTIES, MATERIALEN (zoals MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Veer', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
        _F(GROUP_MA='BRMA1', PHENOMENE='MECANIQUE', MODELISATION='DIS_T'),
    ),
)


cara = AFFE_CARA_ELEM(
    MODELE=model,
    DISCRET=(
        _F(GROUP_MA='Veer',
           CARA='K_T_D_L', REPERE='LOCAL',
           VALE=(1000.0, 0.0, 0.0)),
        _F(GROUP_MA='Veer',
           CARA='M_T_D_L',
           VALE=(0.0,)),
        _F(GROUP_MA='BRMA1', CARA='K_T_D_N', VALE=(0.0, 0.0, 0.0,)),
        _F(GROUP_MA='BRMA1', CARA='M_T_D_N', VALE=(2.0,)),
    ),
)




MAT_BRLEEG = DEFI_MATERIAU(ELAS=_F(E=1.0, NU=0.0),)
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(TOUT='OUI', MATER=MAT_BRLEEG),
    ),
)


# =====================================================
# 3. LASTEN (amplitude; tabellen als functie van de frequentie)
# =====================================================
#-- geen tabellen (amplitude constant over de frequentie) --


bridge_f0 = DEFI_CONSTANTE(VALE=0.0)
bridge_f1 = DEFI_CONSTANTE(VALE=1.0)
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_NO='Grond', DX=0.0, DY=0.0, DZ=0.0),
        _F(GROUP_NO='Massa', DY=0.0, SANS_GROUP_NO=('Grond',)),
        _F(GROUP_NO='Massa', DZ=0.0, SANS_GROUP_NO=('Grond',)),
    ),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_NODALE=_F(GROUP_NO='Last', FX=10.0),
)



# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21) EN EIGENMODES (CALC_MODES, U4.52.02)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    CHARGE=(load_1,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


modes = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='PLUS_PETITE',
    CALC_FREQ=_F(NMAX_FREQ=1),
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    NORM_MODE=_F(NORME='MASS_GENE'),
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
# Modeoverzicht (frequentie, effectieve massa) in de .mess
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.print_modes(modes, mass=masse)


# =====================================================
# 5. BELASTINGSVECTOREN EN PROJECTIE OP DE MODES (PROJ_BASE, U4.63.11)
# =====================================================
vel_1 = CALC_VECT_ELEM(OPTION='CHAR_MECA', CHARGE=load_2, CHAM_MATER=fieldmat, CARA_ELEM=cara)
vec_1 = ASSE_VECTEUR(VECT_ELEM=vel_1, NUME_DDL=numedd)
# Statische verrijking van de modale basis (DYNA_LINE ENRI_STAT)
corr = MACRO_ELAS_MULT(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CARA_ELEM=cara,
    NUME_DDL=numedd,
    CHAR_MECA_GLOBAL=(load_1,),
    CAS_CHARGE=(
        _F(NOM_CAS='c1', CHAR_MECA=load_2, OPTION='SANS'),
    ),
)
bridge_ritz = DEFI_BASE_MODALE(
    RITZ=(_F(MODE_MECA=modes), _F(MODE_INTF=corr)),
    NUME_REF=numedd,
    ORTHO='OUI',
    MATRICE=rigidite,
)
bridge_nug = NUME_DDL_GENE(BASE=bridge_ritz, STOCKAGE='PLEIN')
bridge_mr = PROJ_MATR_BASE(BASE=bridge_ritz, NUME_DDL_GENE=bridge_nug, MATR_ASSE=masse)
bridge_kr = PROJ_MATR_BASE(BASE=bridge_ritz, NUME_DDL_GENE=bridge_nug, MATR_ASSE=rigidite)
bridge_cm = CALC_MODES(
    MATR_MASS=bridge_mr,
    MATR_RIGI=bridge_kr,
    OPTION='TOUT',
    SOLVEUR_MODAL=_F(METHODE='QZ'),
    VERI_MODE=_F(STOP_ERREUR='NON'),
)
bridge_basis = REST_GENE_PHYS(RESU_GENE=bridge_cm, MODE_MECA=bridge_ritz)

PROJ_BASE(
    BASE=bridge_basis,
    STOCKAGE='DIAG',
    MATR_ASSE_GENE=(
        _F(MATRICE=CO('mgen'), MATR_ASSE=masse),
        _F(MATRICE=CO('kgen'), MATR_ASSE=rigidite),
    ),
    VECT_ASSE_GENE=(
        _F(VECTEUR=CO('fgen_1'), VECT_ASSE=vec_1, TYPE_VECT='FORC'),
    ),
)


# =====================================================
# 6. HARMONISCHE RESPONS (DYNA_VIBRA HARM, U4.53.03) EN TERUG NAAR DE
#    KNOPEN (REST_GENE_PHYS, U4.63.31)
# =====================================================
# Modale demping: Mecway's Rayleigh-demping C = alpha M + beta K is
# per mode xi_i = alpha / (2 w_i) + beta w_i / 2 (Mecway manual par.
# 9.26), plus de instelling modal_damping (alleen GENE).
import math as _math
bridge_freqs = [float(_f) for _f in modes.getAccessParameters()['FREQ']]
bridge_alpha, bridge_beta, bridge_zeta = 0.0, 0.0, 0.05
bridge_xi = []
for _f in bridge_freqs:
    _w = 2.0 * _math.pi * _f
    if _w <= 0.0:
        # Starre beweging of mechanisme (bridge_run_aster meldt de
        # oorzaak, zoals bij de respons op modale basis).
        print('BRIDGE_DYNA_MODAL_FOUT FREQ mode=%d f=%g' % (len(bridge_xi) + 1, _f))
        raise ValueError('harmonisch: mode met f <= 0')
    bridge_xi.append(0.5 * (bridge_alpha / _w + bridge_beta * _w) + bridge_zeta)
for _i, (_f, _x) in enumerate(zip(bridge_freqs, bridge_xi)):
    print('BRIDGE_DEMPING mode %d: %.6g Hz, xi = %.6g' % (_i + 1, _f, _x))
if bridge_xi and max(bridge_xi) >= 1.0:
    # Overkritisch gedempte mode: geen resonantiepiek. Anders dan bij
    # de respons op modale basis in de tijd stopt de job niet;
    # bridge_harmonic.report_harmonic meldt het als WARNING.
    print('BRIDGE_HARM_WAARSCHUWING DEMPING MODE=%d XI=%.6g N=%d' % (bridge_xi.index(max(bridge_xi)) + 1, max(bridge_xi), len([_x for _x in bridge_xi if _x >= 1.0])))

# Frequenties: het bereik (lin/log) met 5 punten per mode over de
# halfwaardebreedte 2 xi f rond de piek f sqrt(1 - 2 xi^2)
# (DEFI_LIST_FREQ RAFFINEMENT CRITERE='LARGEUR_3DB', testcase
# sdld21b), of precies de lijst harm_freq_list.
bridge_f0, bridge_f1, bridge_n = 0.5, 7.0, 27
bridge_base = [bridge_f0 + (bridge_f1 - bridge_f0) * _k / float(max(1, bridge_n - 1)) for _k in range(bridge_n)]
bridge_refine = [(_f, _x) for _f, _x in zip(bridge_freqs, bridge_xi)
                 if bridge_f0 <= _f <= bridge_f1 and 0.0 < _x < 0.5]
bridge_base = sorted(set(bridge_base))
if bridge_refine:
    bridge_lf = DEFI_LIST_FREQ(
        VALE=bridge_base,
        RAFFINEMENT=_F(LIST_RAFFINE=[_f for _f, _x in bridge_refine],
                       CRITERE='LARGEUR_3DB', NB_POINTS=5,
                       AMOR_REDUIT=[_x for _f, _x in bridge_refine]),
    )
else:
    bridge_lf = DEFI_LIST_REEL(VALE=bridge_base)
bridge_list = list(bridge_lf.getValues())
print('BRIDGE_HARM_LIJST N=%d FMIN=%.10g FMAX=%.10g VERFIJND=%d BASIS=GENE' % (len(bridge_list), min(bridge_list), max(bridge_list), len(bridge_refine)))
if max(bridge_list) > max(bridge_freqs):
    # Modale truncatie: boven de hoogste mode van de basis volgt de
    # respons de last niet meer (docs/Respons_op_modale_basis.md).
    print('BRIDGE_HARM_WAARSCHUWING BASIS FMAX=%.10g FMODE=%.10g' % (max(bridge_list), max(bridge_freqs)))

# Demping per vector van de basis (met statische verrijking ook
# de pseudo-modes boven de echte modes; dezelfde formule).
bridge_bfreqs = [float(_f) for _f in bridge_basis.getAccessParameters()['FREQ']]
bridge_bxi = [0.5 * (bridge_alpha / (2.0 * _math.pi * _f) + bridge_beta * 2.0 * _math.pi * _f) + bridge_zeta
              for _f in bridge_bfreqs]
if len(bridge_bfreqs) > len(bridge_freqs):
    print('BRIDGE_HARM_VERRIJKING N=%d FREQ=%s' % (len(bridge_bfreqs) - len(bridge_freqs), ','.join('%.6g' % _f for _f in bridge_bfreqs[len(bridge_freqs):])))
harm = DYNA_VIBRA(
    TYPE_CALCUL='HARM',
    BASE_CALCUL='GENE',
    MATR_MASS=mgen,
    MATR_RIGI=kgen,
    AMOR_MODAL=_F(AMOR_REDUIT=bridge_bxi),
    LIST_FREQ=bridge_lf,
    EXCIT=(
        _F(VECT_ASSE_GENE=fgen_1, COEF_MULT=1.0, PHAS_DEG=0.0),
    ),
)

res = REST_GENE_PHYS(
    RESU_GENE=harm,
    TOUT_ORDRE='OUI',
    NOM_CHAM=('DEPL',),
)


# =====================================================
# 7. SPANNINGEN EN RESULTATEN NAAR MECWAY
# =====================================================
#-- geen spanningen gevraagd (fields) --


# Resultaten in Mecway's eigen formaat (result_route 'liml'): een
# <mode frequency> per frequentie (aster_harmonic_export)
import aster_harmonic_export
aster_harmonic_export.export_harmonic(
    res, '<WORKDIR>\\HR-01a\\HR-01a_verif_results.xml', '<WORKDIR>\\HR-01a\\HR-01a.liml',
    fields=['displacements', 'accelerations'],
    probes={'MEETPUNT_Massa': [2]},
    csv_path='<WORKDIR>\\HR-01a\\HR-01a_verif_meetpunten.csv',
    language='nl',
    basis='GENE')


#-- geen MED-export (instelling med_export uit) --


FIN()
