            'N1478', 'N1479', 'N1480', 'N1481', 'N1482', 'N1483', 'N1485', 'N1486',
            'N1487', 'N1488', 'N1489', 'N1490', 'N1492', 'N1493', 'N1494', 'N1495',
            'N1496', 'N1497', 'N1499', 'N1500', 'N1501', 'N1502', 'N1503', 'N1504',
            'N1506', 'N1507',)),
    ),
)

mesh = MODI_MAILLAGE(
    reuse=mesh,
    MAILLAGE=mesh,
    ORIE_PEAU=_F(GROUP_MA_PEAU=('Trek', 'BRERRVRIJ',)),
)


# =====================================================
# 3. MODEL DEFINITIE
# Gegenereerd door bridge_to_aster.py op basis van elset-dimensies.
# Per elset wordt de bijbehorende MODELISATION gekozen:
#   1D (line2)              -> POU_D_E   (Euler-balk; alleen SEG2)
#   2D lineair (tri3/quad4)       -> DKT
#   2D kwadratisch (tri6/quad8)   -> COQUE_3D (na CREA_MAILLAGE MODI_MAILLE)
#   veren (1D met veer-materiaal) -> DIS_T
#   vlakken met druk (op volume)  -> 3D (randelementen)
#   losse knopen (POI1)           -> DIS_T / DIS_TR (zie bridge_mesh.py)
#   3D (hex/tet/wedge/...)  -> 3D
# Zonder elsets, drukvlakken en POI1-knopen wordt TOUT='OUI',
# MODELISATION='3D' gebruikt.
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Plaat', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='Trek', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='BRERRVRIJ', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)


# =====================================================
# 3b. SECTIE-EIGENSCHAPPEN (balken, schalen, veren)
# Gegenereerd door bridge_to_aster.py op basis van Mecway <geometric>-data.
#
# POUTRE: balkdoorsneden (CERCLE, RECTANGLE, ...) per GROUP_MA
#   Voorbeeld: _F(GROUP_MA='Beam1', SECTION='CERCLE', CARA=('R',), VALE=(0.005,))
#   Balk-orientatie: balken met een eigen V-as in Mecway krijgen
#   ORIENTATION CARA='VECT_Y' (model_data["beam_vect_y"]); zonder eigen
#   orientatie zijn de standaarden van Mecway en Code-Aster gelijk.
#
# COQUE: plaat-/schaaldikten per GROUP_MA
#   Voorbeeld: _F(GROUP_MA='Plate1', EPAIS=0.001)
#
# DISCRET: veer-elementen (DIS_T met K_T_D_L stijfheidsmatrix) en
#          losse knopen (POI1, K_T_D_N / K_TR_D_N met stijfheid 0),
#          elk met een aparte massa-entry 0 (M_T_D_L / M_T_D_N / M_TR_D_N)
#   Voorbeeld: _F(GROUP_MA='Spring1', CARA='K_T_D_L', VALE=(4231.0, 0.0, 0.0))
#
# Zonder balk-, schaal- of veersecties en zonder POI1-knopen staat hier:
#   #-- not used in this analysis --
# =====================================================
#-- not used in this analysis --


# =====================================================
# 4. MATERIAAL-DEFINITIE
# Gegenereerd door bridge_to_aster.py op basis van Mecway-materialen.
# Alle waarden in SI-eenheden (Pa, kg/m3, dimensieloos).
# RHO wordt altijd opgenomen (default 0.0) voor compatibiliteit met
# PESANTEUR.
# Conceptnamen MAT_1, MAT_2, ... met de Mecway-naam als commentaar erboven.
# Voorbeeld: MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)
# =====================================================
# materiaal 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=0.0),)


# =====================================================
# 5. MATERIAAL-TOEWIJZING
# Koppelt materialen aan element-sets (GROUP_MA) of, bij afwezigheid
# van elsets, het eerste materiaal aan alle elementen (TOUT='OUI').
# DISCRET-elsets (veren) worden overgeslagen; hun eigenschappen staan
# uitsluitend in AFFE_CARA_ELEM.
# =====================================================
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Plaat', MATER=MAT_1),
    ),
)


# =====================================================
# 6. RANDVOORWAARDEN EN BELASTINGEN
# Gegenereerd door bridge_to_aster.py vanuit model_data["bcs"] en
# model_data["couplings"]. Ondersteunde Code-Aster keywords:
#   DDL_IMPO       - inklemming, opgelegde verplaatsing/rotatie
#   FORCE_NODALE   - puntkrachten
#   PRES_REP       - oppervlaktedruk
#   PESANTEUR      - zwaartekracht (vereist RHO in materiaal)
#   LIAISON_SOLIDE - rigid body coupling (RBE2)
#   LIAISON_RBE3   - distributing coupling (RBE3)
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    LIAISON_OBLIQUE=(
        _F(GROUP_NO='BRSY1', ANGL_NAUT=(0.0, -0.0, 0.0), DX=0.0),
        _F(GROUP_NO='BRSY2', ANGL_NAUT=(90.0, -0.0, 0.0), DX=0.0),
        _F(GROUP_NO='BRSY3', ANGL_NAUT=(0.0, -90.0, 0.0), DX=0.0),
    ),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_FACE=_F(GROUP_MA='Trek', FX=100000000.0),
)


# =====================================================
# 7. SOLVER: LINEAIR STATISCH
# MECA_STATIQUE lost Ku=F op voor lineair elastisch gedrag.
# CARA_ELEM=cara staat erin zodra stap 3b een AFFE_CARA_ELEM bevat
# (balk-, schaal-, veersecties of POI1-knopen); anders weggelaten.
# SOLVEUR (instelling "lin_solver"): MUMPS (direct) met NPREC uit
# "solver_nprec" (Code-Aster-default 8) en RESI_RELA ("lin_solver_resi",
# default 1e-6) als grens voor de geschatte fout op de oplossing; of GCPC
# (iteratief, PRE_COND='LDLT_INC') met RESI_RELA als residu-criterium.
# INFO=2: statistiek van de oplosser in de .mess (convergentiescherm).
# =====================================================
res = MECA_STATIQUE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    EXCIT=(
        _F(CHARGE=load_1),
        _F(CHARGE=load_2),
    ),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8, RESI_RELA=1e-06),
    INFO=2,
)

# =====================================================
# 8. POST-PROCESSING VELDEN BEREKENEN  (CALC_CHAMP)
# Gegenereerd door bridge_to_aster.py op basis van element-typen.
#
# REAC_NODA:
#   Eigen aanroep zonder GROUP_MA (alle knopen); met elastic support
#   zonder de veren (BRES*), zodat de veerkracht de reactie is.
#
# SIGM_NOEU / SIEQ_NOEU:
#   Alleen op de 3D-elsets (GROUP_MA). Schaalspanningen hebben
#   sub-punten (lagen) en passen niet in een NOEU-veld. Zonder
#   3D-elsets (ook bij AFFE_MODELE TOUT='OUI') vervalt deze aanroep.
#
# Schalen (DKT / COQUE_3D):
#   SIGM_ELNO -> POST_CHAMP EXTR_COQUE ('SUP', 'MOY' en 'INF')
#   -> SIEQ_ELNO -> SIEQ_NOEU in res_sup / res_moy / res_inf.
#
# Balken (POU_D_E, doorsnede RECTANGLE of CERCLE):
#   SIPM_ELNO = SIXXMIN / SIXXMAX in de doorsnede.
#
# Foutschatter (instelling error_estimator, alleen volume-elementen):
#   eigen model, last en resultaat res_err, dan CALC_ERREUR ERME_ELEM /
#   ERME_ELNO / ERME_NOEU; zie _error_estimator_block() en
#   docs/Foutschatter.md.
#
# Zie _build_calc_champ_block() in bridge_to_aster.py.
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)

# Spanningen per element-knoop voor Mecway (result_route 'liml').
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    CONTRAINTE=('SIGM_ELNO', ),
)
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    CRITERES=('SIEQ_ELNO', ),
)

res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Plaat',),
    CONTRAINTE=('SIGM_NOEU', ),
    CRITERES=('SIEQ_NOEU', ),
)

# Foutschatter (CALC_ERREUR, residu ERME; bridge 'error_estimator').
# Eigen model (alleen volume-elementen en hun randvlakken), eigen
# last (alle vlak- en volumelasten in een AFFE_CHAR_MECA, PRES_REP ~0
# op de vrije vlakken) en eigen resultaat res_err met de
# verplaatsingen van res.
model_err = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Plaat', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='BRERRVRIJ', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='Trek', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)
fieldmat_err = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model_err,
    AFFE=(
        _F(GROUP_MA='Plaat', MATER=MAT_1),
    ),
)
load_err = AFFE_CHAR_MECA(
    MODELE=model_err,
    FORCE_FACE=_F(GROUP_MA='Trek', FX=-100000000.0),
    PRES_REP=_F(GROUP_MA='BRERRVRIJ', PRES=1e-14),
)
u_all = CREA_CHAMP(TYPE_CHAM='NOEU_DEPL_R', OPERATION='EXTR',
                   RESULTAT=res, NOM_CHAM='DEPL', NUME_ORDRE=1)
u_err = CREA_CHAMP(TYPE_CHAM='NOEU_DEPL_R', OPERATION='ASSE',
                   MODELE=model_err,
                   ASSE=_F(TOUT='OUI', CHAM_GD=u_all,
                           NOM_CMP=('DX', 'DY', 'DZ')))
res_err = CREA_RESU(
    OPERATION='AFFE',
    TYPE_RESU='EVOL_ELAS',
    AFFE=_F(NOM_CHAM='DEPL', CHAM_GD=u_err, MODELE=model_err,
            CHAM_MATER=fieldmat_err, INST=0.0),
)
res_err = CALC_CHAMP(reuse=res_err, RESULTAT=res_err,
                     CONTRAINTE=('SIGM_ELNO', ))
res_err = CALC_ERREUR(
    reuse=res_err,
    RESULTAT=res_err,
    OPTION=('ERME_ELEM', 'ERME_ELNO', 'ERME_NOEU'),
    EXCIT=_F(CHARGE=load_err),
)



# =====================================================
# 9. RESULTAAT-EXTRACTIE NAAR TABELLEN  (POST_RELEVE_T)
# Gegenereerd door bridge_to_aster.py op basis van element-typen.
# Verplaatsingen en reactiekrachten worden altijd geextraheerd.
# tab_sigm / tab_vmis : 3D-elsets
# tab_vmss / tab_vmsm / tab_vmsi : schalen, von Mises boven/midden/onder
# tab_sipm            : balken (RECTANGLE / CERCLE), SIXXMIN / SIXXMAX
# INTITULE is maximaal 16 tekens (Code-Aster kapt langere af).
#
# Aparte tabellen per veld zodat INTITULE (parts[0] in de parser)
# het veld uniek identificeert in AsterToMecway_results()
# in bridge_from_aster.py.
# =====================================================
#-- tabellen niet nodig (result_route='liml') --


# =====================================================
# 10. TABELLEN WEGSCHRIJVEN NAAR .resu  (IMPR_TABLE)
# UNITE=8 -> 'F resu ... R 8' in study.export
# Alleen de tabellen die in stap 9 zijn aangemaakt worden geschreven.
# =====================================================
# Resultaten in Mecway's eigen formaat (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\AD-01-n4\\AD-01-n4_verif_results.xml', '<WORKDIR>\\AD-01-n4\\AD-01-n4.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err')
                       if k in globals()),
    precision='double')


# =====================================================
# 11. EXPORT NAAR MED-FORMAAT (ParaView / Salome), alleen met de
# instelling "med_export" (bridge_to_aster._build_impr_resu_block;
# UNITE=80 -> 'F rmed ... R 80' in study.export). Mecway krijgt de
# resultaten via de .liml of de tabellen, niet via een exportbestand.
# =====================================================
#-- geen MED-export (instelling med_export uit) --


FIN()
