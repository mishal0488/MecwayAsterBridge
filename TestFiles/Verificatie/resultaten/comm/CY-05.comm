        _F(NOEUD=('N26', 'N9', 'N9'), DDL=('DY', 'DX', 'DY'), COEF_MULT=(1.0, -0.49999999999999994, -0.8660254037844387), COEF_IMPO=0.0),
        _F(NOEUD=('N26', 'N9'), DDL=('DZ', 'DZ'), COEF_MULT=(1.0, -1.0), COEF_IMPO=0.0),
