# Code_Aster Command File - Gegenereerd via MecwayAsterBridge
# Template voor DYNA_NON_LINE (niet-lineaire dynamica, impliciet HHT/NEWMARK
# of expliciet DIFF_CENT/TCHAMWA; keuze "schema" in CONFIG_BRIDGE).
# Invulling via Python str.format() vanuit bridge_to_aster.py
# (_build_nonlin_static; zelfde builder en placeholders als STAT_NON_LINE).
#
# Placeholders (zie AsterTemplate_StatNonLine.comm voor de gedeelde):
#   listinst_block    -> outlist (uitvoertijden uit Mecway <timesteps>),
#                        listinst (impliciet: DEFI_LIST_INST met automatisch
#                        knippen; expliciet: per uitvoerinterval een gelijke
#                        stap onder de geschatte CFL-grens, zodat elke
#                        uitvoertijd een rekenstap is)
#                        en vite0 (beginsnelheid, CREA_CHAMP) als die er is
#   statnonline_block -> DEFI_CONTACT (als er contact2 is) en de
#                        DYNA_NON_LINE-aanroep met SCHEMA_TEMPS, ETAT_INIT
#                        en ARCHIVAGE op de uitvoertijden, of de bezwijklus
#                        (bridge_failure.build_solve_block)
#   postreleve_block  -> route 'tabel': POST_RELEVE_T over alle
#                        gearchiveerde tijdstippen (TOUT_ORDRE), inclusief
#                        snelheid (VITE); route 'liml': aster_results_export
#
# LETOP accolades: een letterlijke accolade schrijf je als { of }.

# Taal van de meldingen van de jobscripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH INLEZEN
# FORMAT='ASTER': mesh rechtstreeks uit de .liml (bridge_mesh.py)
# UNITE=20 komt overeen met 'F mail ... D 20' in study.export
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. STANDAARD GROEPEN AANMAKEN (alle elementen / knopen)
# =====================================================
mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

# =====================================================
# 2b. KNOOPGROEPEN VOOR RANDVOORWAARDEN (en mesh-aanpassingen)
# Gegenereerd door _build_defigroup_block(), zelfde als MECA_STATIQUE.
# =====================================================
#-- not used in this analysis --

mesh = MODI_MAILLAGE(
    reuse=mesh,
    MAILLAGE=mesh,
    ORIE_PEAU=_F(GROUP_MA_PEAU=('EindX',)),
)


# =====================================================
# 3. MODEL DEFINITIE
# Per elset wordt de bijbehorende MODELISATION gekozen:
#   1D (line2)              -> POU_D_E   (Euler-balk; alleen SEG2)
#   2D lineair (tri3/quad4)       -> DKT
#   2D kwadratisch (tri6/quad8)   -> COQUE_3D (na CREA_MAILLAGE MODI_MAILLE)
#   veren (1D met veer-materiaal) -> DIS_T
#   vlakken met druk (op volume)  -> 3D (randelementen)
#   losse knopen (POI1)           -> DIS_T / DIS_TR (zie bridge_mesh.py)
#   3D (hex/tet/wedge/...)  -> 3D
# Zonder elsets, drukvlakken en POI1-knopen wordt TOUT='OUI',
# MODELISATION='3D' gebruikt.
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Staaf', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='EindX', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)


# =====================================================
# 3b. SECTIE-EIGENSCHAPPEN (balken, schalen, veren)
# =====================================================
#-- not used in this analysis --


# =====================================================
# 3c. PLASTISCHE HARDINGSCURVES  (DEFI_FONCTION)
# Per materiaal met <plastic>-blok in Mecway wordt een tractiefunctie
# gedefinieerd. Code-Aster TRACTION / VMIS_ISOT_TRAC (U4.43.01 par. 5.1.1):
#   - NOM_PARA='EPSI' : TOTALE rek
#   - NOM_RESU='SIGM' : spanning
#   - De ordinaat van het eerste punt is de elastische grens; een punt
#     met abscis nul is NIET toegestaan. Het eerste punt is dus
#     (sigma_y / E, sigma_y).
#
# De omrekening vanuit Mecway gebeurt in bridge_to_aster.py
# (_to_aster_traction_curve), gestuurd door 'plastic_strain_definition'
# in CONFIG_BRIDGE: 'plastic' -> EPSI = eps_p + sigma/E,
# 'total' -> beginpunt (0, 0) vervalt, 'auto' -> afgeleid uit het
# eerste punt. Ongeldige curves stoppen de generatie met een ERROR in
# bridge_log.txt.
# =====================================================
#-- geen plastische curves in dit model --


# =====================================================
# 4. MATERIAAL-DEFINITIE
# DEFI_MATERIAU met ELAS (altijd) en TRACTION (alleen bij plastische
# materialen). RHO wordt altijd opgenomen voor PESANTEUR-compatibiliteit.
# =====================================================
# materiaal 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)


# =====================================================
# 5. MATERIAAL-TOEWIJZING
# =====================================================
fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Staaf', MATER=MAT_1),
    ),
)


# =====================================================
# 6a. TIJDSAFHANKELIJKE BELASTINGS-FUNCTIES  (DEFI_FONCTION)
# Per <force>-component met time-attribuut wordt een functie van INST
# gedefinieerd. Extrapolatie buiten het gedefinieerde tijdsdomein is
# constant aan beide zijden.
# =====================================================
FN_EindX_FX = DEFI_FONCTION(
    NOM_PARA='INST',
    VALE=(0.0, 0.0,
          0.002, 300000000.0,
          0.004, -150000000.0,
          0.006, 250000000.0,
          0.008, -50000000.0,
          0.01, 0.0),
    PROL_DROITE='CONSTANT',
    PROL_GAUCHE='CONSTANT',
)


# =====================================================
# 6b. TIJDSDISCRETISATIE EN BEGINSNELHEID
# outlist: uitvoertijden (Mecway <timesteps>); listinst: rekenstappen
# (zie de kop van dit bestand); vite0: beginsnelheid.
# =====================================================
outlist = DEFI_LIST_REEL(
    VALE=(0.0001, 0.0002, 0.0003, 0.0004, 0.0005, 0.0006, 0.0007, 0.0008, 0.0009, 0.001, 0.0011, 0.0012, 0.0013, 0.0014, 0.0015, 0.0016, 0.0017, 0.0018, 0.0019, 0.002, 0.0021, 0.0022, 0.0023, 0.0024, 0.0025, 0.0026, 0.0027, 0.0028, 0.0029, 0.003, 0.0031, 0.0032, 0.0033, 0.0034, 0.0035, 0.0036, 0.0037, 0.0038, 0.0039, 0.004, 0.0041, 0.0042, 0.0043, 0.0044, 0.0045, 0.0046, 0.0047, 0.0048, 0.0049, 0.005, 0.0051, 0.0052, 0.0053, 0.0054, 0.0055, 0.0056, 0.0057, 0.0058, 0.0059, 0.006, 0.0061, 0.0062, 0.0063, 0.0064, 0.0065, 0.0066, 0.0067, 0.0068, 0.0069, 0.007, 0.0071, 0.0072, 0.0073, 0.0074, 0.0075, 0.0076, 0.0077, 0.0078, 0.0079, 0.008, 0.0081, 0.0082, 0.0083, 0.0084, 0.0085, 0.0086, 0.0087, 0.0088, 0.0089, 0.009, 0.0091, 0.0092, 0.0093, 0.0094, 0.0095, 0.0096, 0.0097, 0.0098, 0.0099, 0.01),
)

times = DEFI_LIST_REEL(
    DEBUT=0.0,
    INTERVALLE=(
        _F(JUSQU_A=0.0001, NOMBRE=1),
        _F(JUSQU_A=0.0002, NOMBRE=1),
        _F(JUSQU_A=0.0003, NOMBRE=1),
        _F(JUSQU_A=0.0004, NOMBRE=1),
        _F(JUSQU_A=0.0005, NOMBRE=1),
        _F(JUSQU_A=0.0006, NOMBRE=1),
        _F(JUSQU_A=0.0007, NOMBRE=1),
        _F(JUSQU_A=0.0008, NOMBRE=1),
        _F(JUSQU_A=0.0009, NOMBRE=1),
        _F(JUSQU_A=0.001, NOMBRE=1),
        _F(JUSQU_A=0.0011, NOMBRE=1),
        _F(JUSQU_A=0.0012, NOMBRE=1),
        _F(JUSQU_A=0.0013, NOMBRE=1),
        _F(JUSQU_A=0.0014, NOMBRE=1),
        _F(JUSQU_A=0.0015, NOMBRE=1),
        _F(JUSQU_A=0.0016, NOMBRE=1),
        _F(JUSQU_A=0.0017, NOMBRE=1),
        _F(JUSQU_A=0.0018, NOMBRE=1),
        _F(JUSQU_A=0.0019, NOMBRE=1),
        _F(JUSQU_A=0.002, NOMBRE=1),
        _F(JUSQU_A=0.0021, NOMBRE=1),
        _F(JUSQU_A=0.0022, NOMBRE=1),
        _F(JUSQU_A=0.0023, NOMBRE=1),
        _F(JUSQU_A=0.0024, NOMBRE=1),
        _F(JUSQU_A=0.0025, NOMBRE=1),
        _F(JUSQU_A=0.0026, NOMBRE=1),
        _F(JUSQU_A=0.0027, NOMBRE=1),
        _F(JUSQU_A=0.0028, NOMBRE=1),
        _F(JUSQU_A=0.0029, NOMBRE=1),
        _F(JUSQU_A=0.003, NOMBRE=1),
        _F(JUSQU_A=0.0031, NOMBRE=1),
        _F(JUSQU_A=0.0032, NOMBRE=1),
        _F(JUSQU_A=0.0033, NOMBRE=1),
        _F(JUSQU_A=0.0034, NOMBRE=1),
        _F(JUSQU_A=0.0035, NOMBRE=1),
        _F(JUSQU_A=0.0036, NOMBRE=1),
        _F(JUSQU_A=0.0037, NOMBRE=1),
        _F(JUSQU_A=0.0038, NOMBRE=1),
        _F(JUSQU_A=0.0039, NOMBRE=1),
        _F(JUSQU_A=0.004, NOMBRE=1),
        _F(JUSQU_A=0.0041, NOMBRE=1),
        _F(JUSQU_A=0.0042, NOMBRE=1),
        _F(JUSQU_A=0.0043, NOMBRE=1),
        _F(JUSQU_A=0.0044, NOMBRE=1),
        _F(JUSQU_A=0.0045, NOMBRE=1),
        _F(JUSQU_A=0.0046, NOMBRE=1),
        _F(JUSQU_A=0.0047, NOMBRE=1),
        _F(JUSQU_A=0.0048, NOMBRE=1),
        _F(JUSQU_A=0.0049, NOMBRE=1),
        _F(JUSQU_A=0.005, NOMBRE=1),
        _F(JUSQU_A=0.0051, NOMBRE=1),
        _F(JUSQU_A=0.0052, NOMBRE=1),
        _F(JUSQU_A=0.0053, NOMBRE=1),
        _F(JUSQU_A=0.0054, NOMBRE=1),
        _F(JUSQU_A=0.0055, NOMBRE=1),
        _F(JUSQU_A=0.0056, NOMBRE=1),
        _F(JUSQU_A=0.0057, NOMBRE=1),
        _F(JUSQU_A=0.0058, NOMBRE=1),
        _F(JUSQU_A=0.0059, NOMBRE=1),
        _F(JUSQU_A=0.006, NOMBRE=1),
        _F(JUSQU_A=0.0061, NOMBRE=1),
        _F(JUSQU_A=0.0062, NOMBRE=1),
        _F(JUSQU_A=0.0063, NOMBRE=1),
        _F(JUSQU_A=0.0064, NOMBRE=1),
        _F(JUSQU_A=0.0065, NOMBRE=1),
        _F(JUSQU_A=0.0066, NOMBRE=1),
        _F(JUSQU_A=0.0067, NOMBRE=1),
        _F(JUSQU_A=0.0068, NOMBRE=1),
        _F(JUSQU_A=0.0069, NOMBRE=1),
        _F(JUSQU_A=0.007, NOMBRE=1),
        _F(JUSQU_A=0.0071, NOMBRE=1),
        _F(JUSQU_A=0.0072, NOMBRE=1),
        _F(JUSQU_A=0.0073, NOMBRE=1),
        _F(JUSQU_A=0.0074, NOMBRE=1),
        _F(JUSQU_A=0.0075, NOMBRE=1),
        _F(JUSQU_A=0.0076, NOMBRE=1),
        _F(JUSQU_A=0.0077, NOMBRE=1),
        _F(JUSQU_A=0.0078, NOMBRE=1),
        _F(JUSQU_A=0.0079, NOMBRE=1),
        _F(JUSQU_A=0.008, NOMBRE=1),
        _F(JUSQU_A=0.0081, NOMBRE=1),
        _F(JUSQU_A=0.0082, NOMBRE=1),
        _F(JUSQU_A=0.0083, NOMBRE=1),
        _F(JUSQU_A=0.0084, NOMBRE=1),
        _F(JUSQU_A=0.0085, NOMBRE=1),
        _F(JUSQU_A=0.0086, NOMBRE=1),
        _F(JUSQU_A=0.0087, NOMBRE=1),
        _F(JUSQU_A=0.0088, NOMBRE=1),
        _F(JUSQU_A=0.0089, NOMBRE=1),
        _F(JUSQU_A=0.009, NOMBRE=1),
        _F(JUSQU_A=0.0091, NOMBRE=1),
        _F(JUSQU_A=0.0092, NOMBRE=1),
        _F(JUSQU_A=0.0093, NOMBRE=1),
        _F(JUSQU_A=0.0094, NOMBRE=1),
        _F(JUSQU_A=0.0095, NOMBRE=1),
        _F(JUSQU_A=0.0096, NOMBRE=1),
        _F(JUSQU_A=0.0097, NOMBRE=1),
        _F(JUSQU_A=0.0098, NOMBRE=1),
        _F(JUSQU_A=0.0099, NOMBRE=1),
        _F(JUSQU_A=0.01, NOMBRE=1),
    ),
)

listinst = DEFI_LIST_INST(
    DEFI_LIST=_F(LIST_INST=times),
    ECHEC=_F(EVENEMENT='ERREUR', ACTION='DECOUPE',
             SUBD_METHODE='MANUEL', SUBD_PAS=4,
             SUBD_NIVEAU=6),
)



# =====================================================
# 7. RANDVOORWAARDEN EN BELASTINGEN  (AFFE_CHAR_MECA / _F)
# load_1: randvoorwaarden (DDL_IMPO, LIAISON_*) en couplings; daarna een
# last per belasting (FORCE_*, PRES_REP, PESANTEUR), omdat Code-Aster
# belastingen binnen een last overschrijft i.p.v. optelt. Componenten met
# een tijdshistorie verwijzen naar de DEFI_FONCTION's uit stap 6a
# (AFFE_CHAR_MECA_F, of FONC_MULT in EXCIT voor een moment op vlakken).
# =====================================================
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=(
        _F(GROUP_NO='SymX', DX=0.0),
        _F(GROUP_NO='SymY', DY=0.0),
        _F(GROUP_NO='SymZ', DZ=0.0),
    ),
)

load_2 = AFFE_CHAR_MECA_F(
    MODELE=model,
    FORCE_FACE=_F(GROUP_MA='EindX', FX=FN_EindX_FX),
)


# =====================================================
# 8. SOLVER: NIET-LINEAIRE DYNAMICA  (DYNA_NON_LINE)
# Impliciet (HHT/NEWMARK): Newton-Raphson per tijdstap; expliciet
# (DIFF_CENT/TCHAMWA): diagonale massa, geen iteraties, STOP_CFL.
# Contact (DEFI_CONTACT, CONTINUE) en de beginsnelheid (ETAT_INIT VITE)
# staan in dit blok als het model ze heeft.
#
#   CARA_ELEM     - alleen als stap 3b een AFFE_CARA_ELEM bevat.
#   EXCIT         - alle lasten uit stap 7 (load_1, load_2, ...).
#   COMPORTEMENT  - per elset (en POI1-groep): RELATION ('ELAS',
#                   'VMIS_ISOT_TRAC', 'VMIS_ISOT_LINE', 'VMIS_CINE_LINE',
#                   'CABLE' of voor gaps 'DIS_CHOC') en DEFORMATION uit
#                   CONFIG_BRIDGE ("deformation", standaard 'GROT_GDEP';
#                   per elset de vorm die Code-Aster accepteert,
#                   bridge_to_aster._deformation_for). Zonder elsets:
#                   TOUT='OUI', 'ELAS'.
#   INCREMENT     - LIST_INST koppelt aan listinst (stap 6b).
#   SOLVEUR       - MUMPS met NPREC uit CONFIG_BRIDGE ("solver_nprec").
#   NEWTON        - REAC_ITER uit CONFIG_BRIDGE ("newton_reac_iter",
#                   standaard 1 = tangente matrix elke iteratie).
#   CONVERGENCE   - RESI_GLOB_RELA en ITER_GLOB_MAXI uit CONFIG_BRIDGE
#                   ("convergence_resi_rela", "newton_max_iter").
# =====================================================
try:
    res = DYNA_NON_LINE(
        MODELE=model,
        CHAM_MATER=fieldmat,
        EXCIT=(
            _F(CHARGE=load_1),
            _F(CHARGE=load_2),
        ),
        COMPORTEMENT=_F(GROUP_MA='Staaf', RELATION='ELAS', DEFORMATION='GREEN_LAGRANGE'),
        INCREMENT=_F(LIST_INST=listinst),
        SCHEMA_TEMPS=_F(SCHEMA='HHT', ALPHA=-0.1, FORMULATION='DEPLACEMENT'),
        ARCHIVAGE=_F(LIST_INST=outlist),
        SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
        NEWTON=_F(REAC_ITER=1),
        CONVERGENCE=_F(RESI_GLOB_RELA=1e-05, ITER_GLOB_MAXI=20),
    )
except Exception as err:
    if not str(getattr(err, 'id_message', '')).startswith('MECANONLINE'):
        raise
    print('BRIDGE_ONVOLLEDIG', res.getAccessParameters()['INST'][-1])
t_res = res.getAccessParameters()['INST'][-1]


# =====================================================
# 9. POST-PROCESSING VELDEN BEREKENEN  (CALC_CHAMP)
# Zelfde velden als MECA_STATIQUE; heeft minstens een materiaal een
# hardingscurve, dan komen er op de 3D-elsets bij:
#   EPSP_NOEU  - plastische strain tensor
#   VARI_NOEU  - interne variabelen (V1 = eq. plastische strain)
# =====================================================
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    FORCE=('REAC_NODA', ),
)

# Spanningen per element-knoop voor Mecway (result_route 'liml').
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Staaf',),
    CONTRAINTE=('SIGM_ELNO', ),
)
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Staaf',),
    CRITERES=('SIEQ_ELNO', ),
)

res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    GROUP_MA=('Staaf',),
    CONTRAINTE=('SIGM_NOEU', ),
    CRITERES=('SIEQ_NOEU', ),
)

# --- #ASTER-POST-code van de gebruiker (Mecway custom input) ---
WH_ = DEFI_FONCTION(NOM_PARA='SIGM', INTERPOL='LOG', VALE=(100000000.0, 10000000.0, 150000000.0, 2000000.0, 250000000.0, 200000.0, 400000000.0, 10000.0))
MT_ = DEFI_MATERIAU(FATIGUE=_F(WOHLER=WH_))
DM_ = CALC_FATIGUE(TYPE_CALCUL='CUMUL_DOMMAGE', OPTION='DOMA_ELNO_SIGM', HISTOIRE=_F(RESULTAT=res, EQUI_GD='VMIS_SG'), DOMMAGE='WOHLER', MATER=MT_)
print('VERIF_CA_D', max(DM_.getValues()))
# --- einde ---

# =====================================================
# VERMOEIING (bridge: #ASTER-WOHLER, bridge_fatigue.py,
# docs/Vermoeiing.md): schade en levensduur per knoop (Miner)
# =====================================================
import sys
sys.path.insert(0, r'<REPO>\Scripts')
import aster_fatigue
_bridge_vermoeiing = aster_fatigue.compute(
    res, r'<WORKDIR>\VM-06\VM-06.liml', r'<WORKDIR>\VM-06\VM-06_verif_vermoeiing.csv',
    [{'material': 'Staal', 'form': 'table', 'S': [100000000.0, 150000000.0, 250000000.0, 400000000.0], 'N': [10000000.0, 2000000.0, 200000.0, 10000.0], 'interpol': 'LOG', 'prol_gauche': 'EXCLU', 'prol_droite': 'LINEAIRE', 'correction': 'GEEN'}],
    {'stress': 'VMIS_SG', 'counting': 'RAINFLOW', 'repeats': 1.0, 'strain': 'PRIN', 'criterion': 'GEEN', 'loading': 'PERIODIQUE', 'projection': 'UN_AXE'},
    blocks=None, signal=None,
    shells=None)


# =====================================================
# 10. RESULTAAT-EXTRACTIE
# Alle gearchiveerde tijdstippen: route 'liml' (standaard) via
# aster_results_export, route 'tabel' met POST_RELEVE_T TOUT_ORDRE='OUI'
# (de tabel heeft een kolom INST).
# =====================================================
#-- tabellen niet nodig (result_route='liml') --


# =====================================================
# 11. TABELLEN WEGSCHRIJVEN NAAR .resu  (IMPR_TABLE)
# UNITE=8 -> 'F resu ... R 8' in study.export
# =====================================================
# Resultaten in Mecway's eigen formaat (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\VM-06\\VM-06_verif_results.xml', '<WORKDIR>\\VM-06\\VM-06.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf',
                        'res_flux', 'res_err')
                       if k in globals()),
    precision='single', node_fields=globals().get('_bridge_vermoeiing'))


# =====================================================
# 12. EXPORT NAAR MED-FORMAAT (ParaView / Salome), alleen met de
# instelling "med_export" (bridge_to_aster._build_impr_resu_block;
# UNITE=80 -> 'F rmed ... R 80' in study.export). Mecway krijgt de
# resultaten via de .liml of de tabellen, niet via een exportbestand.
# =====================================================
#-- geen MED-export (instelling med_export uit) --


FIN()
