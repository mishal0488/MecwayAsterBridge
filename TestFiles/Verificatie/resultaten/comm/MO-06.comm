# Code_Aster Command File - Gegenereerd via MecwayAsterBridge
# Template voor CALC_MODES: modale analyse (Mecway V30, eigenfrequenties
# en trillingsvormen) en lineaire knik (Mecway B30, kniklastfactoren en
# knikvormen). Invulling via str.format() vanuit bridge_to_aster.py
# (_build_modal).
#
# Placeholders (naam tussen enkele accolades):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE (zoals
#                        MECA_STATIQUE)
#   model_block       -> AFFE_MODELE per elset
#   cara_elem_block   -> AFFE_CARA_ELEM (balken, schalen, veren, knoopmassa's)
#   materials_block   -> DEFI_MATERIAU per materiaal (met RHO)
#   fieldmat_block    -> AFFE_MATERIAU toewijzing
#   loads_block       -> AFFE_CHAR_MECA's: modaal zonder voorspanning alleen
#                        de opleggingen en koppelingen; knik en modaal met
#                        voorspanning ook de belastingen
#   static_block      -> knik en modaal met voorspanning: MECA_STATIQUE met
#                        alle lasten en het spanningsveld SIEF_ELGA daaruit;
#                        modaal zonder voorspanning: commentaar
#   assemblage_block  -> ASSEMBLAGE: stijfheid (RIGI_MECA) en massa
#                        (MASS_MECA) en/of geometrische stijfheid
#                        (RIGI_GEOM); met voorspanning ook RIGI_ROTA
#                        (centrifugaal) en COMB_MATR_ASSE K + Kg
#   calc_modes_block  -> res = CALC_MODES(...)
#   export_block      -> aster_results_export (Mecway-resultaten: een
#                        <mode> per trillings-/knikvorm)
#   impr_resu_block   -> IMPR_RESU MED (alleen met "med_export")
#
# Een accolade die geen placeholder is: verdubbelen ({ of }).

# Taal van de meldingen van de jobscripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --


# =====================================================
# 2. MODEL, SECTIES, MATERIALEN (zoals MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Blok', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)


#-- not used in this analysis --


# materiaal 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Blok', MATER=MAT_1),
    ),
)


# =====================================================
# 3. RANDVOORWAARDEN (en bij knik de belastingen)
# =====================================================
#-- geen randvoorwaarden of belastingen --


# =====================================================
# 4. STATISCHE BEREKENING EN SPANNINGSVELD (KNIK; MODAAL MET VOORSPANNING)
# =====================================================
#-- niet van toepassing (modaal zonder voorspanning) --


# =====================================================
# 5. MATRICES (ASSEMBLAGE, U4.61.21)
# De opleggingen (dualisatie, Lagrange-multiplicatoren) zitten in de
# matrices via CHARGE; hun waarde speelt geen rol.
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


# =====================================================
# 6. EIGENWAARDEN (CALC_MODES, U4.52.02)
# =====================================================
# Vrij-vrij: zoekfrequentie onder 0 (bridge_to_aster._FREE_SHIFT_BLOCK)
import numpy as _np
def _bridge_diag(_m):
    _v, _r, _c, _n = _m.getValuesWithDescription()
    _r, _c, _v = _np.asarray(_r), _np.asarray(_c), _np.asarray(_v)
    _d = _np.zeros(_n)
    _d[_r[_r == _c]] = _v[_r == _c]
    return _d
_kd, _md = _bridge_diag(rigidite), _bridge_diag(masse)
_ok = (_md > 0.0) & (_kd > 0.0)
bridge_fshift = 1.0
if _ok.any():
    bridge_fshift = max(1.0e-3, float(_np.sqrt(1.0e-8 * (_kd[_ok] / _md[_ok]).max())) / (2.0 * _np.pi))
print('BRIDGE_FREE_SHIFT', bridge_fshift)
res = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='CENTRE',
    CALC_FREQ=_F(FREQ=-bridge_fshift, NMAX_FREQ=12),
    CHAM_MATER=fieldmat,
    NORM_MODE=_F(NORME='MASS_GENE'),
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)


# =====================================================
# 7. RESULTATEN NAAR MECWAY
# =====================================================
# Resultaten in Mecway's eigen formaat (bridge: result_route='liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.print_modes(res, mass=masse)
aster_results_export.export_results(
    res, '<WORKDIR>\\MO-06\\MO-06_verif_results.xml', '<WORKDIR>\\MO-06\\MO-06.liml',
    fields=['displacements'], precision='double')


#-- geen MED-export (instelling med_export uit) --


FIN()
