# Code_Aster Command File - Gegenereerd via MecwayAsterBridge
# Template voor MODE_ITER_CYCL: modale analyse met cyclische symmetrie
# (Mecway V30 met een Cyclic symmetry-constraint). Invulling via
# str.format() vanuit bridge_cyclic.py (build_cyclic_modes).
#
# Placeholders (naam tussen enkele accolades):
#   defigroup_block    -> DEFI_GROUP / MODI_MAILLAGE (zoals MECA_STATIQUE)
#   rotate_block       -> symmetrieas X/Y: mesh draaien naar de Z-as
#   model_block        -> AFFE_MODELE per elset
#   cara_elem_block    -> AFFE_CARA_ELEM (knoopmassa's)
#   materials_block    -> DEFI_MATERIAU per materiaal (met RHO)
#   fieldmat_block     -> AFFE_MATERIAU toewijzing
#   loads_block        -> AFFE_CHAR_MECA's (opleggingen; met voorspanning
#                         ook de belastingen)
#   cyclic_loads_block -> snijvlakken vast (cycl_if), relaties ND 0 voor de
#                         voorspanning (cycl_rel)
#   static_block       -> voorspanning: MECA_STATIQUE en SIEF_ELGA
#   assemblage_block   -> ASSEMBLAGE (K, M; met voorspanning K + Kg)
#   base_block         -> sectormodes, DEFI_INTERF_DYNA, DEFI_BASE_MODALE
#   cycl_block         -> MODE_ITER_CYCL, REST_SOUS_STRUC, aster_cyclic
#   export_block       -> aster_results_export (een <mode> per mode)
#   impr_resu_block    -> IMPR_RESU MED (alleen met "med_export")
#
# Een accolade die geen placeholder is: verdubbelen ({ of }).

# Taal van de meldingen van de jobscripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --


# Symmetrieas X -> Z: MODE_ITER_CYCL eist de Z-as (U4.52.05
# par. 1). Het mesh-bestand staat al in het rekenframe (cyclische
# verwisseling van de assen = rotatie -120.0 graden om (1, 1, 1),
# bridge_cyclic._rewrite_mesh), de lasten ook
# (_permute_charges); aster_cyclic draait mesh en vormen terug.


# =====================================================
# 2. MODEL, SECTIES, MATERIALEN (zoals MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Ring', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)


#-- not used in this analysis --


# materiaal 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7800.0),)


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Ring', MATER=MAT_1),
    ),
)


# =====================================================
# 3. RANDVOORWAARDEN EN SNIJVLAKKEN
# =====================================================
#-- geen randvoorwaarden of belastingen --


# Cyclische symmetrie (bridge_cyclic): snijvlakken vast voor de
# sectorbasis (Craig-Bampton, U4.52.05; testcase sdlv134a).
cycl_if = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=_F(
    GROUP_NO=('BRCYC_D', 'BRCYC_G',), DX=0.0, DY=0.0, DZ=0.0))


# =====================================================
# 4. VOORSPANNING (STATISCH, CYCLISCH SYMMETRISCH)
# =====================================================
#-- niet van toepassing (geen voorspanning) --


# =====================================================
# 5. MATRICES VAN DE SECTOR MET VASTE SNIJVLAKKEN (ASSEMBLAGE)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CHARGE=(cycl_if,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


# =====================================================
# 6. BASIS VAN DE SECTOR (CALC_MODES, DEFI_INTERF_DYNA, DEFI_BASE_MODALE)
# =====================================================
# Sectormodes met vaste snijvlakken (basis voor de cyclische
# substructurering)
modes = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='PLUS_PETITE',
    CALC_FREQ=_F(NMAX_FREQ=20),
    CHAM_MATER=fieldmat,
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
lint = DEFI_INTERF_DYNA(
    NUME_DDL=numedd,
    INTERFACE=(
        _F(NOM='DROITE', TYPE='CRAIGB', GROUP_NO='BRCYC_D'),
        _F(NOM='GAUCHE', TYPE='CRAIGB', GROUP_NO='BRCYC_G'),
    ),
)
# Basis: de sectormodes plus de statische modes van de snijvlakken
bamo = DEFI_BASE_MODALE(CLASSIQUE=_F(INTERF_DYNA=lint, MODE_MECA=modes, NMAX_MODE=20))


# =====================================================
# 7. CYCLISCHE MODES (MODE_ITER_CYCL, U4.52.05)
# =====================================================
modcyc = MODE_ITER_CYCL(
    BASE_MODALE=bamo,
    NB_MODE=20,
    NB_SECTEUR=12,
    LIAISON=_F(DROITE='DROITE', GAUCHE='GAUCHE'),
    CALCUL=_F(NB_DIAM=(0, 1, 2, 3, 4, 5, 6), NMAX_FREQ=2),
)
# Modes op sector 1 (per mode het veld DEPL)
modsec = REST_SOUS_STRUC(RESU_GENE=modcyc, SECTEUR=1, NOM_CHAM='DEPL')
# Het hele wiel (instelling cyclic_full_wheel): skelet met de N
# sectoren en de modes daarop; anders alleen de sector.
try:
    squel = DEFI_SQUELETTE(CYCLIQUE=_F(MODE_CYCL=modcyc),
                           SECTEUR=_F(TOUT='OUI'))
    modwiel = REST_SOUS_STRUC(RESU_GENE=modcyc, SQUELETTE=squel,
                              NOM_CHAM='DEPL')
except Exception as exc:
    print('aster_cyclic: WAARSCHUWING: skelet van het hele wiel niet gemaakt: %r' % (exc,))
    squel = modwiel = None
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_cyclic
res = aster_cyclic.collect(modsec, mesh, numedd, 12, 2, [0, 1, 2, 3, 4, 5, 6], axis='X', angle=-120.0, wheel=modwiel, skeleton=squel, liml='<WORKDIR>\\CY-03\\CY-03.liml')


# =====================================================
# 8. RESULTATEN NAAR MECWAY
# =====================================================
# Resultaten in Mecway's eigen formaat (bridge: result_route='liml')
import aster_results_export
aster_results_export.export_results(
    res, '<WORKDIR>\\CY-03\\CY-03_verif_results.xml', '<WORKDIR>\\CY-03\\CY-03.liml',
    fields=['displacements'], precision='double',
    cyclic={'axis': 0, 'segments': 12})


#-- geen MED-export (instelling med_export uit) --


FIN()
