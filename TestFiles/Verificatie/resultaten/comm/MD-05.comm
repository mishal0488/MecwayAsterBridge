# Code_Aster Command File - Gegenereerd via MecwayAsterBridge
# Template voor de respons op modale basis (Mecway Dynamic Response D30 met
# Mode superposition): eigenmodes (CALC_MODES), projectie van massa,
# stijfheid en belastingen op de modes (PROJ_BASE), de modale vergelijkingen
# in de tijd (DYNA_VIBRA BASE_CALCUL='GENE') en terug naar de knopen
# (REST_GENE_PHYS). Invulling via str.format() vanuit bridge_dyna_modal.py.
#
# Placeholders (naam tussen enkele accolades):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE
#   model_block       -> AFFE_MODELE per elset
#   cara_elem_block   -> AFFE_CARA_ELEM (balken, schalen, veren, knoopmassa's)
#   materials_block   -> DEFI_MATERIAU per materiaal (met RHO)
#   fieldmat_block    -> AFFE_MATERIAU toewijzing
#   load_funcs_block  -> DEFI_FONCTION per tijdsafhankelijke component
#   loads_block       -> AFFE_CHAR_MECA(_F): opleggingen en belastingen,
#                        plus de belastingen per tijdsfunctie (gload_*)
#   assemblage_block  -> ASSEMBLAGE: RIGI_MECA en MASS_MECA met de
#                        opleggingen
#   calc_modes_block  -> modes = CALC_MODES(...) en het modeoverzicht
#   projection_block  -> belastingsvectoren (CALC_VECT_ELEM, ASSE_VECTEUR)
#                        en PROJ_BASE
#   dyna_block        -> modale demping, tijdstap, (statische correctie,)
#                        DYNA_VIBRA en REST_GENE_PHYS -> res
#   calc_champ_block  -> CALC_CHAMP (spanningen) op res
#   export_block      -> aster_results_export (Mecway-resultaten per tijdstap)
#   impr_resu_block   -> IMPR_RESU MED (alleen met "med_export")
#
# Een accolade die geen placeholder is: verdubbelen ({ of }).

# Taal van de meldingen van de jobscripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

#-- not used in this analysis --

mesh = MODI_MAILLAGE(
    reuse=mesh,
    MAILLAGE=mesh,
    ORIE_PEAU=_F(GROUP_MA_PEAU=('Eindvlak',)),
)


# =====================================================
# 2. MODEL, SECTIES, MATERIALEN (zoals MECA_STATIQUE)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA='Balk', PHENOMENE='MECANIQUE', MODELISATION='3D'),
        _F(GROUP_MA='Eindvlak', PHENOMENE='MECANIQUE', MODELISATION='3D'),
    ),
)


#-- not used in this analysis --


# materiaal 'Staal'
MAT_1 = DEFI_MATERIAU(ELAS=_F(E=210000000000.0, NU=0.3, RHO=7850.0),)


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Balk', MATER=MAT_1),
    ),
)


# =====================================================
# 3. TIJDSFUNCTIES EN LASTEN
# =====================================================
#-- geen tijdsafhankelijke belastingen in dit model --


bridge_f0 = DEFI_CONSTANTE(VALE=0.0)
bridge_f1 = DEFI_CONSTANTE(VALE=1.0)
load_1 = AFFE_CHAR_MECA(
    MODELE=model,
    DDL_IMPO=_F(GROUP_MA='Inklemming', DX=0.0, DY=0.0, DZ=0.0),
)

load_2 = AFFE_CHAR_MECA(
    MODELE=model,
    FORCE_FACE=_F(GROUP_MA='Eindvlak', FZ=200000.0000000305),
)



# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21) EN EIGENMODES (CALC_MODES, U4.52.02)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    CHARGE=(load_1,),
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigidite'), OPTION='RIGI_MECA'),
        _F(MATRICE=CO('masse'), OPTION='MASS_MECA'),
    ),
)


modes = CALC_MODES(
    TYPE_RESU='DYNAMIQUE',
    MATR_RIGI=rigidite,
    MATR_MASS=masse,
    OPTION='PLUS_PETITE',
    CALC_FREQ=_F(NMAX_FREQ=6),
    CHAM_MATER=fieldmat,
    NORM_MODE=_F(NORME='MASS_GENE'),
    VERI_MODE=_F(SEUIL=1e-06, STOP_ERREUR='NON'),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)
# Modeoverzicht (frequentie, effectieve massa) in de .mess
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_results_export
aster_results_export.print_modes(modes, mass=masse)


# =====================================================
# 5. PROJECTIE OP DE MODES (PROJ_BASE, U4.63.11)
# =====================================================
vel_1 = CALC_VECT_ELEM(OPTION='CHAR_MECA', CHARGE=load_2, CHAM_MATER=fieldmat)
vec_1 = ASSE_VECTEUR(VECT_ELEM=vel_1, NUME_DDL=numedd)
PROJ_BASE(
    BASE=modes,
    STOCKAGE='DIAG',
    MATR_ASSE_GENE=(
        _F(MATRICE=CO('mgen'), MATR_ASSE=masse),
        _F(MATRICE=CO('kgen'), MATR_ASSE=rigidite),
    ),
    VECT_ASSE_GENE=(
        _F(VECTEUR=CO('fgen_1'), VECT_ASSE=vec_1, TYPE_VECT='FORC'),
    ),
)


# =====================================================
# 6. MODALE VERGELIJKINGEN IN DE TIJD (DYNA_VIBRA GENE, U4.53.03) EN
#    TERUG NAAR DE KNOPEN (REST_GENE_PHYS, U4.63.31)
# =====================================================
# Modale demping: Mecway's Rayleigh-demping C = alpha M + beta K is
# per mode xi_i = (alpha / w_i + beta w_i) / 2 (Mecway manual par.
# 9.26), plus de instelling modal_damping.
import math as _math
bridge_freqs = [float(_f) for _f in modes.getAccessParameters()['FREQ']]
bridge_alpha, bridge_beta, bridge_zeta = 0.0, 0.0001, 0.0
bridge_xi = []
for _f in bridge_freqs:
    _w = 2.0 * _math.pi * _f
    if _w <= 0.0:
        # Starre beweging of mechanisme: Mecway staat dat ook niet toe
        # (manual par. 6.4); bridge_run_aster meldt de oorzaak.
        print('BRIDGE_DYNA_MODAL_FOUT FREQ mode=%d f=%g' % (len(bridge_xi) + 1, _f))
        raise ValueError('mode superposition: mode met f <= 0')
    bridge_xi.append(0.5 * (bridge_alpha / _w + bridge_beta * _w) + bridge_zeta)
for _i, (_f, _x) in enumerate(zip(bridge_freqs, bridge_xi)):
    print('BRIDGE_DEMPING mode %d: %.6g Hz, xi = %.6g' % (_i + 1, _f, _x))
if max(bridge_xi) >= 1.0:
    # Mecway: xi < 1 voor elke mode (manual par. 6.4, 9.26).
    print('BRIDGE_DYNA_MODAL_FOUT DEMPING mode=%d xi=%g' % (bridge_xi.index(max(bridge_xi)) + 1, max(bridge_xi)))
    raise ValueError('mode superposition: dempingsverhouding >= 1')

# Rekenstap: 50 stappen per periode van de hoogste mode (NEWMARK,
# periodefout (w dt)^2 / 12), een geheel aantal per uitvoerinterval.
bridge_inc, bridge_nout = 0.0005, 200
bridge_nsub = max(1, int(_math.ceil(bridge_inc * max(bridge_freqs) * 50)))
bridge_pas = bridge_inc / bridge_nsub
print('BRIDGE_DYNA_MODAL rekenstap %g s (%d per uitvoerinterval), %d stappen' % (bridge_pas, bridge_nsub, bridge_nsub * bridge_nout))

tran = DYNA_VIBRA(
    TYPE_CALCUL='TRAN',
    BASE_CALCUL='GENE',
    SCHEMA_TEMPS=_F(SCHEMA='NEWMARK'),
    MATR_MASS=mgen,
    MATR_RIGI=kgen,
    AMOR_MODAL=_F(AMOR_REDUIT=bridge_xi),
    INCREMENT=_F(PAS=bridge_pas, INST_FIN=bridge_inc * bridge_nout),
    ARCHIVAGE=_F(PAS_ARCH=bridge_nsub),
    EXCIT=(
        _F(VECT_ASSE_GENE=fgen_1, FONC_MULT=bridge_f1),
    ),
)

res = REST_GENE_PHYS(
    RESU_GENE=tran,
    TOUT_INST='OUI',
    NOM_CHAM=('DEPL', 'VITE', 'ACCE',),
)


# =====================================================
# 7. SPANNINGEN EN RESULTATEN NAAR MECWAY
# =====================================================
# Spanningen op de fysieke respons (lineair in de verplaatsingen)
# Spanningen per element-knoop voor Mecway (result_route 'liml').
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    MODELE=model,
    CHAM_MATER=fieldmat,
    GROUP_MA=('Balk',),
    CONTRAINTE=('SIGM_ELNO', ),
)
res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    MODELE=model,
    CHAM_MATER=fieldmat,
    GROUP_MA=('Balk',),
    CRITERES=('SIEQ_ELNO', ),
)

res = CALC_CHAMP(
    reuse=res,
    RESULTAT=res,
    MODELE=model,
    CHAM_MATER=fieldmat,
    GROUP_MA=('Balk',),
    CONTRAINTE=('SIGM_NOEU', ),
    CRITERES=('SIEQ_NOEU', ),
)



# Resultaten in Mecway's eigen formaat (bridge: result_route='liml')
aster_results_export.export_results(
    res, '<WORKDIR>\\MD-05\\MD-05_verif_results.xml', '<WORKDIR>\\MD-05\\MD-05.liml',
    extra_results=dict((k, globals()[k]) for k in
                       ('res_sup', 'res_moy', 'res_inf')
                       if k in globals()),
    precision='single', static=False, fields=['displacements', 'velocities', 'stresses', 'vonmises'])


#-- geen MED-export (instelling med_export uit) --


FIN()
