# Code_Aster Command File - Gegenereerd via MecwayAsterBridge
# Template voor het harmonische drukveld (akoestiek, analyse
# acoustic_harm_3d op een Mecway A30-model): PHENOMENE='ACOUSTIQUE',
# ASSEMBLAGE RIGI_ACOU/MASS_ACOU/AMOR_ACOU en DYNA_VIBRA
# TYPE_CALCUL='HARM' (route van testcase ahlv100a). Invulling via
# str.format() vanuit bridge_acoustic.py (build_acoustic_harm).
#
# Placeholders (naam tussen enkele accolades):
#   model_block       -> AFFE_MODELE (volumes en bronvlakken 3D,
#                        absorberende vlakken 3D_ABSO)
#   materials_block   -> DEFI_MATERIAU FLUIDE per materiaal (en per
#                        impedantie)
#   fieldmat_block    -> AFFE_MATERIAU toewijzing
#   loads_block       -> AFFE_CHAR_ACOU VITE_FACE (bron) / PRES_IMPO en
#                        #ASTER-code
#   assemblage_block  -> ASSEMBLAGE matrices en lastvectoren
#   harm_block        -> frequentielijst en res = DYNA_VIBRA(...)
#   export_block      -> aster_acoustic_export (een <mode> per frequentie,
#                        microfoons)
#   impr_resu_block   -> IMPR_RESU MED (alleen met "med_export")
#
# Een accolade die geen placeholder is: verdubbelen ({ of }).

# Taal van de meldingen van de jobscripts (aster_*.py)
import os as _bridge_os
_bridge_os.environ['BRIDGE_LANGUAGE'] = 'nl'
DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

# =====================================================
# 2. MODEL EN MATERIALEN (lucht/vloeistof, randen)
# =====================================================
model = AFFE_MODELE(
    MAILLAGE=mesh,
    AFFE=(
        _F(GROUP_MA=('Lucht', 'BRON_Entree',), PHENOMENE='ACOUSTIQUE', MODELISATION='3D'),
        _F(GROUP_MA=('ABSORBEREND_Einde',), PHENOMENE='ACOUSTIQUE', MODELISATION='3D_ABSO'),
    ),
)


# materiaal 'Lucht'
MAC1 = DEFI_MATERIAU(FLUIDE=_F(RHO=1.3, CELE_R=343.0))


fieldmat = AFFE_MATERIAU(
    MAILLAGE=mesh,
    MODELE=model,
    AFFE=(
        _F(GROUP_MA='Lucht', MATER=MAC1),
        _F(GROUP_MA='BRON_Entree', MATER=MAC1),
        _F(GROUP_MA='ABSORBEREND_Einde', MATER=MAC1),
    ),
)


# =====================================================
# 3. BRONNEN EN OPGELEGDE DRUK; vlakken zonder voorwaarde zijn harde wanden
# =====================================================
# Bron: normaalsnelheid de fluid in (VITE_FACE VNOR)
ch_vite = AFFE_CHAR_ACOU(
    MODELE=model,
    VITE_FACE=(
        _F(GROUP_MA='BRON_Entree', VNOR=('RI', 0.014, 0.0)),  # BRON_-selectie BRON_Entree
    ),
)


# =====================================================
# 4. MATRICES EN LASTVECTOREN (ASSEMBLAGE, U4.61.21)
# =====================================================
ASSEMBLAGE(
    MODELE=model,
    CHAM_MATER=fieldmat,
    NUME_DDL=CO('numedd'),
    MATR_ASSE=(
        _F(MATRICE=CO('rigi_c'), OPTION='RIGI_ACOU'),
        _F(MATRICE=CO('mass_c'), OPTION='MASS_ACOU'),
        _F(MATRICE=CO('amor_c'), OPTION='AMOR_ACOU'),
    ),
    VECT_ASSE=(
        _F(VECTEUR=CO('vec_v'), OPTION='CHAR_ACOU', CHARGE=ch_vite),
    ),
)


# =====================================================
# 5. HARMONISCHE RESPONS (DYNA_VIBRA HARM, U4.53.03)
# =====================================================
freqs = DEFI_LIST_REEL(VALE=(500.0,))
res = DYNA_VIBRA(
    TYPE_CALCUL='HARM',
    BASE_CALCUL='PHYS',
    CHAM_MATER=fieldmat,
    MATR_MASS=mass_c,
    MATR_RIGI=rigi_c,
    MATR_AMOR=amor_c,
    LIST_FREQ=freqs,
    EXCIT=(
        _F(VECT_ASSE=vec_v, COEF_MULT=1.0, PUIS_PULS=1, PHAS_DEG=90.0),
    ),
    SOLVEUR=_F(METHODE='MUMPS', NPREC=8),
)


# =====================================================
# 6. RESULTATEN NAAR MECWAY
# =====================================================
# Resultaten in Mecway's eigen formaat (result_route 'liml')
import sys
sys.path.insert(0, '<REPO>\\Scripts')
import aster_acoustic_export
aster_acoustic_export.export_harmonic(
    res, '<WORKDIR>\\AH-04\\AH-04_verif_results.xml', '<WORKDIR>\\AH-04\\AH-04.liml',
    microphones={},
    csv_path='<WORKDIR>\\AH-04\\AH-04_verif_microfoons.csv',
    language='nl')


#-- geen MED-export (instelling med_export uit) --


FIN()
