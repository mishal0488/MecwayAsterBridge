# Code_Aster Command File - Gegenereerd via MecwayAsterBridge
# Template voor de respons op modale basis (Mecway Dynamic Response D30 met
# Mode superposition): eigenmodes (CALC_MODES), projectie van massa,
# stijfheid en belastingen op de modes (PROJ_BASE), de modale vergelijkingen
# in de tijd (DYNA_VIBRA BASE_CALCUL='GENE') en terug naar de knopen
# (REST_GENE_PHYS). Invulling via str.format() vanuit bridge_dyna_modal.py.
#
# Placeholders (naam tussen enkele accolades):
#   defigroup_block   -> DEFI_GROUP / CREA_MAILLAGE / MODI_MAILLAGE
#   model_block       -> AFFE_MODELE per elset
#   cara_elem_block   -> AFFE_CARA_ELEM (balken, schalen, veren, knoopmassa's)
#   materials_block   -> DEFI_MATERIAU per materiaal (met RHO)
#   fieldmat_block    -> AFFE_MATERIAU toewijzing
#   load_funcs_block  -> DEFI_FONCTION per tijdsafhankelijke component
#   loads_block       -> AFFE_CHAR_MECA(_F): opleggingen en belastingen,
#                        plus de belastingen per tijdsfunctie (gload_*)
#   assemblage_block  -> ASSEMBLAGE: RIGI_MECA en MASS_MECA met de
#                        opleggingen
#   calc_modes_block  -> modes = CALC_MODES(...) en het modeoverzicht
#   projection_block  -> belastingsvectoren (CALC_VECT_ELEM, ASSE_VECTEUR)
#                        en PROJ_BASE
#   dyna_block        -> modale demping, tijdstap, (statische correctie,)
#                        DYNA_VIBRA en REST_GENE_PHYS -> res
#   calc_champ_block  -> CALC_CHAMP (spanningen) op res
#   export_block      -> aster_results_export (Mecway-resultaten per tijdstap)
#   impr_resu_block   -> IMPR_RESU MED (alleen met "med_export")
#
# Een accolade die geen placeholder is: verdubbelen ({{ of }}).

DEBUT(LANG='EN')

# =====================================================
# 1. MESH (FORMAT='ASTER', bridge_mesh.py; UNITE=20 = 'F mail ... D 20')
# =====================================================
mesh = LIRE_MAILLAGE(UNITE=20, FORMAT='ASTER')

mesh = DEFI_GROUP(
    reuse=mesh,
    MAILLAGE=mesh,
    CREA_GROUP_MA=_F(
        NOM='all_elems',
        TOUT='OUI',
    ),
    CREA_GROUP_NO=_F(
        NOM='all_nodes',
        GROUP_MA='all_elems',
    ),
)

{defigroup_block}

# =====================================================
# 2. MODEL, SECTIES, MATERIALEN (zoals MECA_STATIQUE)
# =====================================================
{model_block}

{cara_elem_block}

{materials_block}

{fieldmat_block}

# =====================================================
# 3. TIJDSFUNCTIES EN LASTEN
# =====================================================
{load_funcs_block}

{loads_block}

# =====================================================
# 4. MATRICES (ASSEMBLAGE, U4.61.21) EN EIGENMODES (CALC_MODES, U4.52.02)
# =====================================================
{assemblage_block}

{calc_modes_block}

# =====================================================
# 5. PROJECTIE OP DE MODES (PROJ_BASE, U4.63.11)
# =====================================================
{projection_block}

# =====================================================
# 6. MODALE VERGELIJKINGEN IN DE TIJD (DYNA_VIBRA GENE, U4.53.03) EN
#    TERUG NAAR DE KNOPEN (REST_GENE_PHYS, U4.63.31)
# =====================================================
{dyna_block}

# =====================================================
# 7. SPANNINGEN EN RESULTATEN NAAR MECWAY
# =====================================================
{calc_champ_block}

{export_block}

{impr_resu_block}

FIN()
